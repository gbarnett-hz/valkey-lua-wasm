+/* wasm: Valkey gets its CPU's result out of range; these follow the host's (valkey_cvt.c). */
+#define lua_number2integer(i,d)	((i)=valkey_d2ll(d))
+long long valkey_d2ll(double d);
+int valkey_d2i(double d);
+unsigned long long valkey_d2ull(double d);
 
 #endif
 
