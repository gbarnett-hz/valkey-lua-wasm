<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hazelcast</groupId>
    <artifactId>experimental.lua</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <chicory.version>1.7.5</chicory.version>
        <luajava.version>4.0.2</luajava.version>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencies>
        <!-- WasmValkeyLua: runs ../lua/lua.wasm, bundled in the jar. -->
        <dependency>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>runtime</artifactId>
            <version>${chicory.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>wasi</artifactId>
            <version>${chicory.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>compiler</artifactId>
            <version>${chicory.version}</version>
        </dependency>
        <!-- JniValkeyLua: same luajava and loader versions as Infinispan; the natives come from ../native (make -C native). -->
        <dependency>
            <groupId>party.iroiro.luajava</groupId>
            <artifactId>lua51</artifactId>
            <version>${luajava.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-jnigen-loader</artifactId>
            <version>2.5.2</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <!-- Benchmarks: src/test/java/valkeylua/*Bench.java. -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>../lua</directory>
                <targetPath>valkeylua</targetPath>
                <includes>
                    <include>lua.wasm</include>
                </includes>
            </resource>
            <resource>
                <directory>../native/build</directory>
                <includes>
                    <include>liblua51*</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Builds lua.wasm and this platform's natives; make skips both when they're up to date. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>lua</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>make</executable>
                            <arguments><argument>-C</argument><argument>${project.basedir}/../lua</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>native</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>make</executable>
                            <arguments><argument>-C</argument><argument>${project.basedir}/../native</argument></arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- WasmValkeyLuaTest.memoryCapIsAnOrdinaryLuaError fills Chicory's ~2 GiB memory. No -Xss: the
                         suite runs at the JVM's default thread stack. -->
                    <argLine>-Xmx4g</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
